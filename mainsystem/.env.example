# Default: offline harness verification. No live AI or physical motion.
SWARM_PROVIDER=scripted
DEVICE_MODE=simulated

# Presentation fixtures: populated stock, stations and WaterSentry Plus 51300C.
# Use scripts/start-demo.ps1 after connecting Mel and ElevenLabs.
# This simulates devices/data only; it does not substitute scripted agents for Mel.
SHOPSWARM_DEMO_MODE=false

# Mel live mode: obtain the hosted base URL from the organizers. Do not guess it.
# The documented localhost:7711 relay is for source development, not assumed installed.
MEL_RELAY_URL=
MEL_TOKEN=
MEL_MODEL=auto
MEL_DEVICE_ID=shopswarm-laptop

# Explicit fallback only: any verified chat-completions-compatible provider.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ElevenLabs: provision a private agent with the included setup command.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=
ELEVENLABS_LLM=

# Speakers: silence mic during playback to prevent self-interruption/echo loops.
# Headphones: allow speaking over the agent; use only with isolated headphones.
SHOPSWARM_AUDIO_MODE=speakers

# Quarky adapter contract: set only after its actual transport is implemented and tested.
QUARKY_BRIDGE_URL=
QUARKY_BRIDGE_TOKEN=
