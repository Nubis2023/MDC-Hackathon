# Backend configuration.
#
# Copy this to `.env` (repo root) and fill in what you need. `.env` is
# gitignored — never commit real credentials.
#
# The server loads `.env` at startup via Node's process.loadEnvFile. Real
# environment variables always win, so CI and hosted environments are
# unaffected by this file's presence.

# ── Which database ──────────────────────────────────────────────────────
# Leave SUPABASE_DB_URL unset to run on local SQLite. Set it to point the
# whole service — API, seed, and tests — at Postgres/Supabase.
#
# Use the DIRECT connection (port 5432), not the connection pooler, and not
# the REST URL. Find it under Project Settings → Database → Connection string.
#
# This is NOT the anon/publishable key and NOT the service role key: those
# are API credentials, this is a Postgres DSN.
#
# SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# TLS mode for the Postgres connection: require (default) | no-verify | disable.
# Keep `require` for Supabase; `disable` is only for a local server.
# SUPABASE_DB_SSL=require

# ── Local SQLite (used when SUPABASE_DB_URL is unset) ───────────────────
DB_FILE=./server/data/ledger.db

# ── Server ──────────────────────────────────────────────────────────────
PORT=4000
# Directory of the built frontend, served by the API so both share an origin.
# WEB_DIST=./web/dist

# ── Supabase API credentials (not needed to run the backend) ────────────
# The service role key BYPASSES row level security. Server-side only.
# Never expose it to the browser, never commit it, never prefix it with a
# framework-public marker (VITE_, NEXT_PUBLIC_, etc.).
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# The publishable/anon key is safe for browsers but must NOT be used by this
# backend — it is subject to RLS and cannot read across sellers.
# SUPABASE_PUBLISHABLE_KEY=

# ── Test harness ────────────────────────────────────────────────────────
# Point the test suite at Postgres instead of in-memory SQLite. Tests truncate
# tables between cases, so do NOT aim this at a database you care about.
# TEST_POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
# TEST_POSTGRES_SSL=disable
